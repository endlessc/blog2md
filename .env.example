# ==========================================
# LLM Configuration
# ==========================================

# 指定当前使用的服务商 (provider)
# 可选值: openai, deepseek, kimi, qwen, doubao, custom
LLM_PROVIDER=deepseek

# ==========================================
# 1. Deepseek (深度求索)
# 官网: https://platform.deepseek.com/
# ==========================================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
# 2. Kimi (Moonshot AI / 月之暗面)
# 官网: https://platform.moonshot.cn/
# ==========================================
KIMI_API_KEY=your_moonshot_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ==========================================
# 3. Qwen (通义千问 / 阿里云 DashScope)
# 官网: https://dashscope.console.aliyun.com/
# 注意: 需要使用兼容 OpenAI 的接口地址
# ==========================================
QWEN_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ==========================================
# 4. Doubao (豆包 / 火山引擎)
# 官网: https://console.volcengine.com/ark
# 注意: 豆包的 Model ID 通常不是固定的模型名，而是你在控制台创建的推理接入点 ID (Endpoint ID)
# ==========================================
DOUBAO_API_KEY=your_volcengine_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-2024xxxxxx-xxxxx

# ==========================================
# 5. OpenAI (默认)
# ==========================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# 6. Custom (自定义)
# 如果你使用其他服务商或本地模型 (如 Ollama, vLLM)
# ==========================================
CUSTOM_API_KEY=your_custom_key
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=llama3
